# Copy to .env and fill in values for local development.

# Local dev (SQLite)
DATABASE_URL=sqlite:///./tutorial_builder.db

# Vercel Postgres — auto-injected when Storage is linked to the project:
# POSTGRES_URL=postgres://...
# POSTGRES_URL_NON_POOLING=postgres://...
# No manual DATABASE_URL needed on Vercel if Postgres storage is connected.

# LLM provider (required for pipeline stages)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Firecrawl — powers the Web Research pipeline stage
# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=
